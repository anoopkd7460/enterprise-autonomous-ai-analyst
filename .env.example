# LLM

GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# Application

APP_ENV=development

# Database

DATABASE_URL=sqlite:///./data/sample/sales.db

# Redis

REDIS_ENABLED=false
